# Central Core V3 — Environment Variables Example
# Copy to .env and fill with real values (never commit .env)

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# ── Per-App Secrets (Supabase vault only — never in .env) ──
# AI_CORE_SECRET_WYLONI="..."
# AI_CORE_SECRET_KEYDRAFT="..."
# AI_CORE_SECRET_SOTTRA="..."
# AI_CORE_SECRET_REGIADS="..."
# AI_CORE_SECRET_PRATICA="..."
# AI_CORE_SECRET="..."           # Legacy shared fallback (transitional)
#
# ── Access Model (Supabase vault only) ──
# CORE_ADMIN_BOOTSTRAP_EMAILS="owner@example.com"          # Owner/admin (one account only)
# CORE_USER_BYPASS_EMAILS="user@example.com"               # Non-paying users, cross-app bypass (no admin)
# CORE_WYLONI_BYPASS_EMAILS="user@example.com"             # Non-paying users, Wyloni-only bypass (no admin)
