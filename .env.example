# AI_CORE_SECRET_KEYDRAFT="..."
# AI_CORE_SECRET_SOTTRA="..."
# AI_CORE_SECRET_REGIADS="..."
# AI_CORE_SECRET_PRATICA="..."
# AI_CORE_SECRET="..."           # Legacy shared fallback (transitional)
